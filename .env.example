# ==================================================
# TeenTrack Backend Environment Variables (.env.example)
# ==================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Supabase Credentials (Keep SERVICE_ROLE_KEY backend-only! Never expose to client!)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# JWT Authentication (Backend only)
JWT_SECRET=super_secret_jwt_key_at_least_32_chars_long_for_security
JWT_EXPIRES_IN=7d
